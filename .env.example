# Example Windows Docker Desktop: C:/Proyectos/MiAPI
# Example Linux: /home/you/projects/myapi
HOST_WORKSPACE=C:/Proyectos/MiAPI
# Must be the ENABLED OpenClaw OpenAI-compatible chat endpoint base (typically /v1).
# Cloudflare Tunnel must forward this API endpoint; dashboard access alone is insufficient.
OPENCLAW_API_URL=https://openclaw.kdvops.com/v1
OPENCLAW_TOKEN=REPLACE_WITH_YOUR_GATEWAY_TOKEN
OPENCLAW_MODEL=openclaw
