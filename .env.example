# Example Windows Docker Desktop: C:/Proyectos/MiAPI
# Example Linux: /home/you/projects/myapi
HOST_WORKSPACE=C:/Proyectos/MiAPI
# Linux only: set this to `id -u` if the container needs write access to host files.
KDVOPS_UID=10001
# Must be the ENABLED OpenClaw OpenAI-compatible chat endpoint base (typically /v1).
# Cloudflare Tunnel must forward this API endpoint; dashboard access alone is insufficient.
OPENCLAW_API_URL=https://kdvops-cli.kdvops.com/v1
OPENCLAW_TOKEN=REPLACE_WITH_YOUR_BROKER_TOKEN
OPENCLAW_MODEL=openclaw/kdvops
# Required when the endpoint is protected by a Cloudflare Access Service Token.
CF_ACCESS_CLIENT_ID=REPLACE_WITH_YOUR_CF_ACCESS_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=REPLACE_WITH_YOUR_CF_ACCESS_CLIENT_SECRET
# Emergency opt-in only. Sensitive files are blocked by default.
KDVOPS_ALLOW_SENSITIVE_READS=false
# Separate, higher-risk opt-in for modifying a sensitive file.
KDVOPS_ALLOW_SENSITIVE_WRITES=false
