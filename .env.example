# Example Windows Docker Desktop: C:/Proyectos/MiAPI
# Example Linux: /home/you/projects/myapi
HOST_WORKSPACE=C:/Proyectos/MiAPI
# Host path to the kubeconfig mounted read-only inside the container.
# Windows example: C:/Users/you/.kube/config
# Linux example: /home/you/.kube/config
HOST_KUBECONFIG=C:/Users/you/.kube/config
# Linux only: set this to `id -u` if the container needs write access to host files.
KDVOPS_UID=10001
# Build-time pip hosts whose TLS certificates are not validated.
KDVOPS_PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
# Must be the ENABLED OpenClaw OpenAI-compatible chat endpoint base (typically /v1).
# Cloudflare Tunnel must forward this API endpoint; dashboard access alone is insufficient.
OPENCLAW_API_URL=https://kdvops-cli.kdvops.com/v1
OPENCLAW_TOKEN=REPLACE_WITH_YOUR_BROKER_TOKEN
OPENCLAW_MODEL=openclaw/kdvops
# Allow enough time for gateway orchestration and cloud model responses.
KDVOPS_TIMEOUT=300
KDVOPS_RUN_TIMEOUT=1800
# Browser chat port. History is persisted in the kdvops-history Docker volume.
KDVOPS_WEB_PORT=8080
# Browser Basic Auth password (minimum 32 characters; use a random unique value).
KDVOPS_WEB_TOKEN=REPLACE_WITH_A_RANDOM_32_CHARACTER_TOKEN
# Disable only when a trusted workplace proxy breaks certificate validation.
# WARNING: false permits man-in-the-middle interception of credentials and traffic.
KDVOPS_TLS_VERIFY=true
# Emergency-only TLS bypass. Credentials can be intercepted.
# KDVOPS_TLS_VERIFY=false
# Required when the endpoint is protected by a Cloudflare Access Service Token.
CF_ACCESS_CLIENT_ID=REPLACE_WITH_YOUR_CF_ACCESS_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=REPLACE_WITH_YOUR_CF_ACCESS_CLIENT_SECRET
# Emergency opt-in only. Sensitive files are blocked by default.
KDVOPS_ALLOW_SENSITIVE_READS=false
# Separate, higher-risk opt-in for modifying a sensitive file.
KDVOPS_ALLOW_SENSITIVE_WRITES=false
# Explicit network opt-in. Hosts are exact matches; redirects are never followed.
KDVOPS_HTTP_ENABLED=false
KDVOPS_HTTP_ALLOWED_HOSTS=dev.azure.com
# Optional Azure DevOps PAT, injected only for https://dev.azure.com requests.
AZURE_DEVOPS_PAT=
# Session-local masking before any content is sent to the LLM.
KDVOPS_PRIVACY_MASKING=true
# Optional exact sensitive values separated by || (prefer secret injection over this file).
KDVOPS_PRIVACY_SENSITIVE_VALUES=
